# This app's own database — a dedicated "delta_admin" schema on your Supabase project's
# Postgres instance (kept separate from the `applications` source table). Get both URIs from
# the Supabase dashboard: Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?schema=delta_admin&pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?schema=delta_admin"
AUTH_SECRET=""                 # random string signing login session cookies — generate with `openssl rand -base64 32`
SCORING_PROVIDER=""             # anthropic | groq | heuristic — auto-detected from whichever key below is set if left blank
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
EMAIL_PROVIDER="stub"          # stub | resend | gmail
RESEND_API_KEY=""
GMAIL_USER=""                  # e.g. yourname@gmail.com — the sending account
GMAIL_APP_PASSWORD=""          # Google Account > Security > App Passwords (requires 2-Step Verification on)
TEST_EMAIL_OVERRIDE=""         # force all prototype mail to one inbox
APPLICATION_SOURCE="seed"      # seed | zoho_crm | google_form | supabase
GOOGLE_FORM_ID=""              # provided later
GOOGLE_INGEST_SECRET=""        # shared secret for the form webhook
ZOHO_CLIENT_ID=""              # future
ZOHO_CLIENT_SECRET=""          # future
ZOHO_REFRESH_TOKEN=""          # future
SUPABASE_URL=""                # Supabase project URL — live rapid re.gen applications table
SUPABASE_ANON_KEY=""           # Supabase anon/public key (read-only RLS policy, safe to expose client-side)
CHALLENGE_NAME="the^delta prize · rapid re.gen challenge"
SHORTLIST_SIZE="20"
SEARCH_API_KEY=""              # optional — enables search-based enrichment (news/reputation), website fetch works without it
SEARCH_ENGINE_ID=""            # Google Custom Search engine id, if using Google as the provider
